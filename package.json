{
  "name": "@melkmeshi/telescope",
  "description": "An elegant debug assistant for Node.js (based on Laravel Telescope).",
  "author": "Damian Chojnacki <damianchojnacki@op.pl> (https://damianchojnacki.com)",
  "contributors": [
    "Mohamed Elkmeshi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MElkmeshi/telescope.git"
  },
  "version": "2.1.0",
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./drizzle": {
      "types": "./dist/esm/drizzle/index.d.ts",
      "default": "./dist/esm/drizzle/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/example/index.ts",
    "dev": "tsx watch --ignore ./db.json src/example/index.ts",
    "build": "tsc -p tsconfig.esm.json && ./bin/build-types.sh",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "stack-utils": "^2.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@types/express": "^4.17.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^2.0.12",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^30.4.1",
    "body-parser": "^2.3.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "jest": "^30.4.2",
    "pg": "^8.23.0",
    "supertest": "^6.2.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "express": "^4.17.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": false
    }
  }
}
